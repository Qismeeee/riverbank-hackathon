// ezXRiverbank mini project: underwriting and LOS handoff only.
// Design specification, not an executable PostgreSQL migration.
// Import into a DBML-compatible ERD editor.

Project ezx_riverbank_mini {
  database_type: 'PostgreSQL'
  Note: '''
    Scope: one marketplace, one partner bank, VND, one shop per seller record,
    one application per lot, one final human decision per application.
    Bank/platform/product settings and approved policy artifacts live in
    versioned configuration. Authentication uses an external identity provider
    or explicit development-only test identities; no password tables here.
    No credit accounts, disbursement, billing, accounting or debt collection.

    JSONB contracts are described below. Validate them in application code.
    FK and CHECK constraints do not enforce workflow transitions, authorization,
    live consent validity, JSON citations or evidence immutability by themselves.
    Application changes and the corresponding event must commit atomically.
    UUIDs are generated by the application. Timestamps are supplied in UTC.
  '''
}

Enum application_status {
  DRAFT
  BLOCKED_INPUT
  ANALYZING
  NO_LOAN_NEEDED
  AWAITING_STATEMENT
  VERIFYING
  PENDING_REVIEW
  ESCALATED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

Enum run_status {
  RUNNING
  COMPLETED
  FAILED
}

Enum document_validation_status {
  PENDING
  PASSED
  FAILED
}

Enum decision_type {
  ACCEPT_PROPOSAL
  ACCEPT_COUNTER
  REJECT
}

Enum handoff_status {
  PENDING
  SENDING
  SUCCEEDED
  FAILED
}

Table sellers {
  seller_id uuid [pk]
  external_shop_ref varchar(128) [not null, unique]
  display_name varchar(255) [not null]
  bank_customer_ref varchar(128) [note: 'Optional CIF/reference supplied by partner bank; no local eKYC.']
  created_at timestamptz [not null, default: `now()`]

  Note: 'Mini assumption: one seller record represents one borrowing shop. Multi-shop ownership is deferred.'
}

Table seller_consents {
  consent_id uuid [pk]
  seller_id uuid [not null, ref: > sellers.seller_id]
  purpose_code varchar(80) [not null, default: 'WORKING_CAPITAL_UNDERWRITING']
  terms_version varchar(50) [not null]
  granted_at timestamptz [not null]
  expires_at timestamptz
  revoked_at timestamptz

  indexes {
    (consent_id, seller_id) [unique]
    (seller_id, granted_at)
  }
  checks {
    `expires_at IS NULL OR expires_at > granted_at` [name: 'ck_consent_expiry']
    `revoked_at IS NULL OR revoked_at >= granted_at` [name: 'ck_consent_revocation']
  }
  Note: 'Before every source-data fetch, the service verifies purpose, expiry and revocation. FK only verifies ownership.'
}

Table applications {
  application_id uuid [pk]
  application_number varchar(80) [not null, unique]
  seller_id uuid [not null, ref: > sellers.seller_id]
  consent_id uuid [not null]
  status application_status [not null, default: 'DRAFT']
  lot_value numeric(18,2) [not null]
  cash_on_hand numeric(18,2) [not null]
  sell_weeks integer [not null]
  requested_amount numeric(18,2) [not null]
  supplier_schedule jsonb [not null, note: 'Array of {week: 0-based integer, amount: decimal string}. Validate non-negative weeks, positive amounts and total matching lot_value.']
  sanitized_note text [note: 'Only input-guardrail-approved text; do not store unnecessary raw PII.']
  currency char(3) [not null, default: 'VND']
  version_no bigint [not null, default: 1]
  submitted_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (seller_id, created_at)
    (status, created_at)
  }
  checks {
    `lot_value > 0 AND cash_on_hand >= 0 AND requested_amount >= 0` [name: 'ck_application_amounts']
    `sell_weeks > 0 AND version_no >= 1` [name: 'ck_application_versions_tenor']
    `currency = 'VND'` [name: 'ck_application_currency']
    `jsonb_typeof(supplier_schedule) = 'array' AND jsonb_array_length(supplier_schedule) > 0` [name: 'ck_supplier_schedule_array']
  }
  Note: '''
    Inputs are immutable after submission. Updated plans require a new application.
    Hard caps and sanitized input validation are enforced before ANALYZING.
    Gap zero -> NO_LOAN_NEEDED; no approval on that application.
    Approval requires an authorized bank user. No ANALYZING -> ACCEPTED transition.
    Handoff failures do not change ACCEPTED/REJECTED to another application status.
    Check version_no on state writes and increment it to avoid concurrent decisions.
  '''
}

Table assessment_runs {
  run_id uuid [pk]
  application_id uuid [not null, ref: > applications.application_id]
  run_no integer [not null]
  status run_status [not null, default: 'RUNNING']
  idempotency_key varchar(128) [not null, unique]
  input_snapshot jsonb [not null, note: 'Sanitized plan, historical weekly payouts, shop features, source period/fetched_at, consent checked_at, source document IDs/hashes and bank pricing if supplied. Money uses decimal strings.']
  input_hash varchar(64) [not null, note: 'SHA-256 of canonical snapshot bytes.']
  engine_version varchar(100) [not null]
  policy_version varchar(100) [not null]
  policy_hash varchar(64) [not null]
  model_version varchar(100) [note: 'Nullable when risk scoring is skipped for gap zero.']
  config_snapshot jsonb [not null, note: 'Stress/buffer factors, rounding, deduction cap, tenor bounds and policy/model/config artifact references. Approved configuration only.']
  cashflow_result jsonb [note: 'gap, first/last_negative_week, proposed_amount, tenor_weeks, deductions[], base_table[], stress_table[], support_limit, payout_warning_threshold, affordability_pass. Tables include week, opening, inflow, outflow, closing.']
  risk_result jsonb [note: 'pd in [0,1], factors[{name, direction, shap}]. Null for gap zero.']
  policy_result jsonb [note: 'rules[{rule_id, pass, hard, clause_ref}], recommendation. Null for gap zero.']
  statement_check jsonb [note: 'required, document_ids[], period, platform_amount, statement_amount, mismatch_pct, compare_table[], outcome. Null if not performed.']
  result_schema_version varchar(30) [not null, default: '1.0']
  error_code varchar(80)
  started_at timestamptz [not null, default: `now()`]
  completed_at timestamptz

  indexes {
    (application_id, run_no) [unique]
    (run_id, application_id) [unique]
  }
  checks {
    `run_no > 0` [name: 'ck_run_number']
    `completed_at IS NULL OR completed_at >= started_at` [name: 'ck_run_time']
    `status <> 'COMPLETED' OR (completed_at IS NOT NULL AND cashflow_result IS NOT NULL)` [name: 'ck_completed_run']
  }
  Note: '''
    This table combines cashflow/risk/policy/statement results to reduce table count.
    A completed run is immutable. A new statement or new assessment creates a new run.
    The service validates typed JSON contracts, integer week conventions, Decimal
    money, deterministic results and approved/tested policy artifacts.
    Proposal schedules are simulations, not actual loan repayment obligations.
  '''
}

Table evidence {
  evidence_id uuid [pk]
  application_id uuid [not null]
  run_id uuid [not null]
  evidence_code varchar(30) [not null, note: 'Human-readable E1, E2, etc., scoped to one run.']
  kind varchar(50) [not null, note: 'PAYOUT_HISTORY, CASHFLOW, RISK, POLICY, STATEMENT_COMPARISON.']
  schema_version varchar(30) [not null, default: '1.0']
  payload jsonb [not null]
  payload_hash varchar(64) [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (run_id, evidence_code) [unique]
  }
  Note: 'Append-only snapshots. Citations use evidence_id, not evidence_code alone. Hash canonical JSON. Do not regenerate old evidence from live marketplace data.'
}

Table application_documents {
  document_id uuid [pk]
  application_id uuid [not null, ref: > applications.application_id]
  document_type varchar(50) [not null, default: 'BANK_STATEMENT']
  file_name varchar(255) [not null]
  object_key varchar(500) [not null, note: 'Stable object key, never an expiring presigned URL.']
  object_version varchar(255) [note: 'S3 version ID if available; otherwise use a unique non-overwritable object key.']
  content_hash varchar(64) [not null]
  media_type varchar(100) [not null]
  received_at timestamptz [not null, default: `now()`]

  indexes {
    (application_id, received_at)
  }
  Note: 'Input uploads only. Comparison results belong to the assessment run. Generated memo/explainer belong to generated_documents.'
}

Table generated_documents {
  document_id uuid [pk]
  application_id uuid [not null]
  run_id uuid [not null]
  attempt_no integer [not null]
  underwriter_memo text [not null]
  seller_explainer text [not null]
  citation_map jsonb [not null, note: 'Sentence IDs/text, evidence_ids and structured field/value references; validate ownership and exact numeric agreement.']
  validation_status document_validation_status [not null, default: 'PENDING']
  validation_errors jsonb [not null, default: `'[]'::jsonb`]
  llm_model varchar(100) [not null, note: 'Use TEMPLATE if produced without an LLM.']
  prompt_version varchar(100) [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (run_id, attempt_no) [unique]
    (document_id, run_id, application_id) [unique]
  }
  checks {
    `attempt_no BETWEEN 1 AND 3` [name: 'ck_memo_attempts']
  }
  Note: 'One row contains both outputs from the same run. Retain failed attempts; append a new row for rewrite. Third failure escalates with draft clearly marked. No invented bank interest/fees.'
}

Table decisions {
  decision_id uuid [pk]
  application_id uuid [not null, unique, ref: > applications.application_id]
  run_id uuid [not null]
  generated_document_id uuid [not null]
  decision decision_type [not null]
  final_amount numeric(18,2)
  final_tenor_weeks integer
  final_cashflow_result jsonb [note: 'Final deterministic calculation and proposed deduction schedule, using final terms; includes engine/config references and affordability result. Null for rejection.']
  verification_note text [note: 'Required by service before approval of an escalated application.']
  reason text [not null]
  actor_ref varchar(128) [not null, note: 'Authenticated bank user subject, derived server-side.']
  decided_at timestamptz [not null, default: `now()`]

  indexes {
    (decision_id, application_id) [unique]
  }
  checks {
    `(decision = 'REJECT' AND final_amount IS NULL AND final_tenor_weeks IS NULL AND final_cashflow_result IS NULL) OR (decision IN ('ACCEPT_PROPOSAL', 'ACCEPT_COUNTER') AND final_amount IS NOT NULL AND final_amount > 0 AND final_tenor_weeks IS NOT NULL AND final_tenor_weeks > 0 AND final_cashflow_result IS NOT NULL)` [name: 'ck_decision_terms']
  }
  Note: '''
    One immutable final decision per application for the mini project.
    In one transaction: authorize user, lock/check application version, verify
    selected run/documents, recompute affordability for final terms, insert decision,
    set ACCEPTED/REJECTED and append event. No approval for NO_LOAN_NEEDED.
    Verify escalated cases before approval; never let the LLM write decisions.
  '''
}

Table handoffs {
  handoff_id uuid [pk]
  application_id uuid [not null, unique]
  decision_id uuid [not null, unique]
  idempotency_key varchar(128) [not null, unique]
  status handoff_status [not null, default: 'PENDING']
  payload jsonb [not null, note: 'Frozen package: decision, approved terms/schedule if accepted, documents, evidence, risk/policy and actor/time. Rejections contain no disbursement amount.']
  payload_hash varchar(64) [not null]
  los_ref varchar(128)
  attempt_count integer [not null, default: 0]
  last_error text
  last_attempt_at timestamptz
  delivered_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  checks {
    `attempt_count >= 0` [name: 'ck_handoff_attempts']
  }
  Note: 'Create pending handoff with the decision transaction. Retry frozen payload with same key; LOS/mock must deduplicate. Persist failures without undoing decision. Record each attempt in application_events. No core/disbursement calls.'
}

Table application_events {
  event_id bigint [pk, increment]
  application_id uuid [not null, ref: > applications.application_id]
  event_type varchar(80) [not null, note: 'STATE_CHANGED, DECISION_RECORDED, HANDOFF_ATTEMPT, etc.']
  previous_status application_status
  next_status application_status
  actor_type varchar(20) [not null, note: 'HUMAN or SYSTEM.']
  actor_ref varchar(128) [not null]
  reason_code varchar(80)
  evidence_ids jsonb [not null, default: `'[]'::jsonb`]
  details jsonb [not null, default: `'{}'::jsonb`, note: 'Non-sensitive run/decision/handoff references and error codes. No raw prompts or bank account details.']
  occurred_at timestamptz [not null, default: `now()`]

  indexes {
    (application_id, occurred_at, event_id)
  }
  checks {
    `actor_type IN ('HUMAN', 'SYSTEM')` [name: 'ck_event_actor']
    `event_type <> 'STATE_CHANGED' OR next_status IS NOT NULL` [name: 'ck_state_event']
  }
  Note: 'Append-only: enforce DB privileges or triggers in the migration, no user update/delete API. Validate evidence references belong to this application. A state event commits with its application update.'
}

Ref: applications.(consent_id, seller_id) > seller_consents.(consent_id, seller_id)
Ref: evidence.(run_id, application_id) > assessment_runs.(run_id, application_id)
Ref: generated_documents.(run_id, application_id) > assessment_runs.(run_id, application_id)
Ref: decisions.(generated_document_id, run_id, application_id) > generated_documents.(document_id, run_id, application_id)
Ref: handoffs.(decision_id, application_id) > decisions.(decision_id, application_id)
