# Optional local overrides. The API starts without this file or any credentials.
RIVERBANK_APP_NAME=Riverbank Hackathon API
RIVERBANK_ENVIRONMENT=local
RIVERBANK_HOST=127.0.0.1
RIVERBANK_PORT=8000
RIVERBANK_LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:3000,https://ezxriverbank-hackathon.vercel.app

# Optional cloud settings. Real credentials belong only in the ignored .env.
# RIVERBANK_ENV=cloud
# AWS_PROFILE=riverbank
# AWS_REGION=ap-southeast-1
# S3_BUCKET=your-existing-bucket
# DATABASE_URL=postgresql://user:password@db.example:15432/database?hostaddr=127.0.0.1&sslmode=verify-full&sslrootcert=/path/to/rds-ca.pem
# DB_HOST=db.example
# DB_PORT=5432
# DB_NAME=database
# DB_SECRET_ID=your-database-secret-reference
# DB_SSLROOTCERT=/path/to/rds-ca.pem
# DB_LOCAL_PORT=15432
# SSH_HOST=your-ec2-host
# SSH_USER=ubuntu
# SSH_KEY_FILE=/path/to/private-key.pem
# SSH_KNOWN_HOSTS_FILE=/path/to/verified-known-hosts
# OPENROUTER_API_KEY=
# ADDLIVETAG_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional Kafka/Redis over SSH or SSM tunnels; never connect FE directly.
# KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:19092
# KAFKA_USERNAME=riverbank
# KAFKA_PASSWORD=
# KAFKA_TOPIC_PREFIX=riverbank-hackathon
# REDIS_HOST=127.0.0.1
# REDIS_PORT=16379
# REDIS_USERNAME=riverbank
# REDIS_PASSWORD=
# REDIS_KEY_PREFIX=riverbank-hackathon:
# COGNITO_ISSUER=https://cognito-idp.ap-southeast-1.amazonaws.com/your-pool-id
# COGNITO_CLIENT_ID=your-public-web-client-id
