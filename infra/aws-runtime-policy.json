{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ProjectContainerLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:ap-southeast-1:424016506356:log-group:/riverbank-hackathon/app:log-stream:*"
    },
    {
      "Sid": "ProjectHostMetrics",
      "Effect": "Allow",
      "Action": "cloudwatch:PutMetricData",
      "Resource": "*",
      "Condition": {"StringEquals": {"cloudwatch:namespace": "RiverbankHackathon/Host"}}
    }
  ]
}
